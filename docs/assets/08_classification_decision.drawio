        <mxCell id="ok" parent="1" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;Accepted as a page&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 10px&#39;&gt;returned to the caller, and stored&lt;/font&gt;" vertex="1">
