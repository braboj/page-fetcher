          <mxGeometry height="120" width="300" x="70" y="195" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" value="Wall, challenge or&lt;br&gt;throttle stub?" vertex="1">
