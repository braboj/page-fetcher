        <mxCell id="body" parent="1" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;A response body&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 10px&#39;&gt;from a transport, or read back from the store&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="280" x="490" y="60" as="geometry" />
        </mxCell>
