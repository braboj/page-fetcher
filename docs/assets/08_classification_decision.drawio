        </mxCell>
        <mxCell id="d4" parent="1" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" value="Below the size floor?&lt;br&gt;&lt;font style=&#39;font-size: 10px&#39;&gt;measured on raw markup,&lt;br&gt;never on text&lt;/font&gt;" vertex="1">
