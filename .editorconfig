root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2

# Captured HTML fixtures are frozen byte-for-byte snapshots of real
# responses — reformatting one changes the test input.
[pagefetch/tests/fixtures/**]
insert_final_newline = false
trim_trailing_whitespace = false
