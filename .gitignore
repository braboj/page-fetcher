# Build output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Test and coverage
.pytest_cache/
.coverage
htmlcov/

# Fetch cache — pagefetch's own on-disk response cache
.cache/

# Secrets
.env
.env.local
*.pem
*.key

# IDE and editor — .vscode is an allowlist, not a wholesale ignore. The
# two tracked files mirror the CI gates, and leaving them untracked makes
# every contributor reproduce the Pylance-defers-to-mypy setup by hand.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# Crash dumps — Cygwin/Git-Bash tools drop these in the working directory
*.stackdump

# OS
.DS_Store
Thumbs.db
desktop.ini
